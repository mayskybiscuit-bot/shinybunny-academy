{
  "buildCommand": "echo 'No build needed - static + serverless'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index-CLEAN.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index-CLEAN.html"
    }
  ],
 
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
